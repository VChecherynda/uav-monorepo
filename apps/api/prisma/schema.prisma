// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FlightPhase {
  ON_GROUND
  TAKEOFF
  IN_AIR
  LANDING
}

enum FlightMode {
  AUTO
  RTL
  LAND
  LOITER
}

enum Disposition {
  ACTIVE
  EXPENDED
}

enum UnitRole {
  COMMANDER
  OPERATOR
}

model Drone {
  id          String      @id @default(cuid())
  missionId   String?
  name        String
  flightPhase FlightPhase @default(ON_GROUND)
  flightMode  FlightMode  @default(LOITER)
  disposition Disposition @default(ACTIVE)
  battery     Int
  altitude    Int
  lng         Float
  lat         Float
  homeLng     Float       @default(133.8800)
  homeLat     Float       @default(-23.7000)
  unitId      String?
  updatedAt   DateTime    @updatedAt
  createdAt   DateTime    @default(now())
  telemetries Telemetry[]
  missions    Mission?    @relation(fields: [missionId], references: [id], onDelete: Restrict)
  unit        Unit?       @relation(fields: [unitId], references: [id], onDelete: SetNull)
}

model Telemetry {
  id         String   @id @default(cuid())
  droneId    String
  battery    Int
  altitude   Int
  lng        Float
  lat        Float
  recordedAt DateTime @default(now())
  drone      Drone    @relation(fields: [droneId], references: [id])

  @@index([droneId, recordedAt])
}

model Unit {
  id          String     @id @default(cuid())
  name        String     @unique
  missions    Mission[]
  drones      Drone[]
  unitMembers UnitMember[]
  invitations Invitation[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime @updatedAt
}

model Mission {
  id        String     @id @default(cuid())
  name      String     @db.VarChar(120)
  status    String     @default("draft") // "draft" | "assigned" | "in-progress | "completed" | "aborted"
  reason    String?
  createdAt DateTime   @default(now())
  unitId    String
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Restrict)
  unit      Unit      @relation(fields: [unitId], references: [id], onDelete: Restrict)
  waypoints Waypoint[]
  drones    Drone[]
}

model Waypoint {
  id         String   @id @default(cuid())
  lng        Float
  lat        Float
  missionId  String
  order      Int
  recordedAt DateTime @default(now())
  mission    Mission  @relation(fields: [missionId], references: [id])
}

model Geofence {
  id        String   @id @default(cuid())
  name      String
  area      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  missions     Mission[]
  unitMember   UnitMember?
  invitations  Invitation[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model UnitMember {
  id              String     @id @default(cuid())
  unitId          String
  userId          String     @unique
  unitRole        UnitRole
  canAcceptDrones Boolean    @default(false)
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit            Unit       @relation(fields: [unitId], references: [id], onDelete: Restrict)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model Invitation {
  id          String     @id @default(cuid())
  code        String     @unique
  unitId      String
  unitRole    UnitRole
  expiresAt   DateTime
  usedAt      DateTime?
  createdBy   String
  createdAt   DateTime   @default(now())
  unit        Unit       @relation(fields: [unitId], references: [id], onDelete: Restrict)
  creator     User       @relation(fields: [createdBy], references: [id], onDelete: Restrict)
}
